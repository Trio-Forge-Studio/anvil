{
	"name": "@trioforge/anvil",
	"version": "0.1.3",
	"description": "Headless UI primitives for Roblox games, built on Vide",
	"keywords": [
		"roblox",
		"roblox-ts",
		"vide",
		"ui",
		"headless",
		"gamepad"
	],
	"homepage": "https://website.trio-forge.workers.dev/docs/anvil/",
	"bugs": "https://github.com/Trio-Forge-Studio/anvil/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Trio-Forge-Studio/anvil.git"
	},
	"license": "MIT",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": [
		"out",
		"!**/*.tsbuildinfo",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rbxtsc --type package",
		"test": "rbxtsc --type package && lune run test",
		"check": "vp check && stylua --check test .lune && rbxtsc --type package && lune run test && pnpm run examples README.md",
		"prepack": "rbxtsc --type package",
		"examples": "node tooling/check-examples.mjs",
		"fmt": "vp fmt",
		"prepare": "vp config",
		"changeset": "changeset"
	},
	"peerDependencies": {
		"@rbxts/charm": "^0.11.1",
		"@rbxts/services": "^1.6.0",
		"@rbxts/vide": "^0.6.1",
		"@rbxts/vide-charm": "^0.4.1"
	},
	"devDependencies": {
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "3.0.3",
		"@rbxts/charm": "0.11.1",
		"@rbxts/compiler-types": "3.0.0-types.0",
		"@rbxts/services": "1.6.0",
		"@rbxts/types": "1.0.959",
		"@rbxts/vide": "0.6.1",
		"@rbxts/vide-charm": "0.4.1",
		"roblox-ts": "3.0.0",
		"typescript": "5.5.3",
		"vite-plus": "1.3.0"
	},
	"packageManager": "pnpm@12.15.0"
}
