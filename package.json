{
	"name": "@trioforge/anvil",
	"version": "0.1.1",
	"description": "Headless UI primitives for Roblox games, built on Vide",
	"keywords": [
		"roblox",
		"roblox-ts",
		"vide",
		"ui",
		"headless",
		"gamepad"
	],
	"bugs": "https://github.com/Trio-Forge-Studio/packages/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Trio-Forge-Studio/packages.git",
		"directory": "packages/anvil"
	},
	"license": "MIT",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": [
		"out",
		"!**/*.tsbuildinfo",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rbxtsc --type package",
		"test": "rbxtsc --type package && lune run test",
		"check": "stylua --check test .lune && rbxtsc --type package && lune run test && pnpm run examples README.md",
		"prepack": "rbxtsc --type package",
		"examples": "check-examples"
	},
	"peerDependencies": {
		"@rbxts/charm": "^0.11.1",
		"@rbxts/services": "^1.6.0",
		"@rbxts/vide": "^0.6.1",
		"@rbxts/vide-charm": "^0.4.1"
	},
	"devDependencies": {
		"@rbxts/charm": "^0.11.1",
		"@rbxts/compiler-types": "catalog:rbxts",
		"@rbxts/services": "^1.6.0",
		"@rbxts/types": "catalog:rbxts",
		"@rbxts/vide": "^0.6.1",
		"@rbxts/vide-charm": "^0.4.1",
		"@trioforge/tooling": "workspace:*",
		"roblox-ts": "catalog:rbxts",
		"typescript": "catalog:rbxts"
	}
}
