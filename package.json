{
	"name": "@trioforge/anvil",
	"version": "0.1.1",
	"description": "Headless UI primitives for Roblox games, built on Vide",
	"keywords": ["roblox", "roblox-ts", "vide", "ui", "headless", "gamepad"],
	"bugs": "https://github.com/Trio-Forge-Studio/anvil/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Trio-Forge-Studio/anvil.git"
	},
	"license": "MIT",
	"main": "out/init.luau",
	"types": "out/index.d.ts",
	"files": ["out", "!**/*.tsbuildinfo", "README.md", "LICENSE"],
	"packageManager": "pnpm@12.15.0",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rbxtsc --type package",
		"test": "rbxtsc --type package && lune run test",
		"fmt": "oxfmt src scripts",
		"check": "oxfmt --check src scripts && rbxtsc --type package && stylua --check test .lune && lune run test && node scripts/check-snippets.mjs README.md",
		"prepack": "rbxtsc --type package"
	},
	"peerDependencies": {
		"@rbxts/charm": "^0.11.1",
		"@rbxts/services": "^1.6.0",
		"@rbxts/vide": "^0.6.1",
		"@rbxts/vide-charm": "^0.4.1"
	},
	"devDependencies": {
		"@rbxts/charm": "^0.11.1",
		"@rbxts/compiler-types": "3.0.0-types.0",
		"@rbxts/services": "^1.6.0",
		"@rbxts/types": "^1.0.958",
		"@rbxts/vide": "^0.6.1",
		"@rbxts/vide-charm": "^0.4.1",
		"oxfmt": "^0.74.0",
		"roblox-ts": "^3.0.0",
		"typescript": "5.5.3"
	}
}
