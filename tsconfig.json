{
	"extends": "./tsconfig.rbxts.json",
	"compilerOptions": {
		"jsx": "react",
		"jsxFactory": "Vide.jsx",
		"jsxFragmentFactory": "Vide.Fragment",
		"typeRoots": ["node_modules/@rbxts"],
		"rootDir": "src",
		"outDir": "out",
		"tsBuildInfoFile": "out/tsconfig.tsbuildinfo"
	},
	"include": ["src"]
}
